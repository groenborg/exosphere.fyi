---
import type { BroadcastItem } from "../../lib/content";
import { shortDate } from "../../lib/dates";

interface Props {
  items: BroadcastItem[];
  /** Shown when there's nothing to list. */
  empty?: string;
}

const { items, empty = "No broadcasts yet — check back soon." } = Astro.props;
---
<div class="list">
  <div class="list__container">
    {items.length === 0 && <p class="list__empty">{empty}</p>}
    {items.map((item) => (
      <article class="list__item">
        <ul class="meta">
          <li><time datetime={item.pubDate.toISOString()}>{shortDate(item.pubDate)}</time></li>
          {item.minutesRead && <li>{item.minutesRead}</li>}
          {item.draft && <li>Draft</li>}
          {item.tags.map((tag) => (
            <li><a href={`/broadcasts/tags/${tag}`}>{tag}</a></li>
          ))}
        </ul>
        <h2 class="list__title">
          <a href={`/broadcasts/${item.id}`}>{item.title}</a>
        </h2>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
</div>
