---
interface Props {
  /** "signals" renders the compact link-list footer used on the landing page. */
  variant?: "default" | "signals";
}
const { variant = "default" } = Astro.props;
const year = new Date().getFullYear();
---
{variant === "signals" ? (
  <footer>
    <div class="sig-foot">
      <ul>
        <li><a href="/">Signals</a></li>
        <li><a href="/made">Made</a></li>
        <li><a href="/transmissions">Transmissions</a></li>
        <li><a href="/craft">Craft</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <ul>
        <li><a href="mailto:hello@exosphere.studio">hello@exosphere.studio</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li class="sig-foot__meta">© {year} Exosphere Studio</li>
      </ul>
    </div>
  </footer>
) : (
  <footer>
    <div class="wrap">
      <div class="foot">
        <div>
          <div class="foot__brand">Exosphere ✦</div>
          <p class="foot__tag">A small studio building joyful, personal software from somewhere quiet near the sky.</p>
        </div>
        <div class="foot__col">
          <h4 class="foot__col-h">Studio</h4>
          <ul>
            <li><a href="/about">About &amp; history</a></li>
            <li><a href="/craft">Craft</a></li>
            <li><a href="/made">Made</a></li>
          </ul>
        </div>
        <div class="foot__col">
          <h4 class="foot__col-h">Channels</h4>
          <ul>
            <li><a href="/transmissions">Transmissions</a></li>
            <li><a href="/rss.xml">RSS</a></li>
            <li><a href="#">Are.na</a></li>
          </ul>
        </div>
        <div class="foot__col">
          <h4 class="foot__col-h">Signal</h4>
          <ul>
            <li><a href="mailto:hello@exosphere.studio">hello@exosphere.studio</a></li>
            <li><a href="#">+45 00 00 00 00</a></li>
            <li><a href="#">@exosphere</a></li>
          </ul>
        </div>
      </div>
      <div class="foot__bottom">
        <span>© {year} Exosphere Studio</span>
      </div>
    </div>
  </footer>
)}
