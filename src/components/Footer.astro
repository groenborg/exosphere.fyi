        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
    <ul>
      <li><a href="mailto:hello@exosphere.studio">hello@exosphere.studio</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li class="foot__meta">© {year} Exosphere Studio</li>
    </ul>
  </div>
</footer>
