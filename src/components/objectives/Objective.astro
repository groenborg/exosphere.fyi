---
interface Props {
  /** Zero-padded index, e.g. "00", "07", "14". */
  num: string;
  title: string;
  href: string;
  /** One-line summary, revealed inline when the objective is opened. */
  description: string;
  /** Label for the onward link inside the open panel. */
  linkLabel?: string;
}
const { num, title, href, description, linkLabel = "Read in full" } = Astro.props;

/* Every objective carries the same `name`, so the browser closes the last-open
   one for us — only one is ever unfolded, and no JS is involved. */
const group = "objective";
---
<details class="objective" name={group}>
  <summary class="objective__header">
    <span class="objective__num">{num}.</span>
    <span class="objective__title">{title}</span>
  </summary>
  <div class="objective__panel">
    <div class="objective__panel-body">
      <p>{description}</p>
      <ul class="links">
        <li><a href={href}>{`${linkLabel} →`}</a></li>
      </ul>
    </div>
  </div>
</details>
