---
interface Props {
  /** Zero-padded index, e.g. "00", "07", "14". */
  num: string;
  title: string;
  href: string;
  /** One-line summary, revealed inline when the objective is opened. */
  description: string;
}
const { num, title, href, description } = Astro.props;

/* Every objective carries the same `name`, so the browser closes the last-open
   one for us — only one is ever unfolded, and no JS is involved. */
const group = "objective";
---
<details class="objective" name={group}>
  <summary class="objective__header">
    <span class="objective__num">{num}.</span>
    <span class="objective__title">{title}</span>
  </summary>
  <div class="objective__panel">
    <div class="objective__panel-body">
      <p>{description}</p>
      {/* No label: the arrow is the whole invitation, so the accessible name
          has to carry the destination. */}
      <a class="objective__more" href={href} aria-label={`Read ${title} in full`}>
        <svg class="objective__arrow" viewBox="0 0 40 8" aria-hidden="true" focusable="false">
          <path
            d="M0.5 4H39M34 0.5 38.5 4 34 7.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</details>
