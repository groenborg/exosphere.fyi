---
interface Props {
  /** Zero-padded index, e.g. "00", "07", "14". */
  num: string;
  title: string;
  href: string;
  /** One-line summary, revealed inline when the objective is opened. */
  description?: string;
  /** Label for the onward link inside the open panel. */
  linkLabel?: string;
  /** Name shared by every objective so only one stays open at a time. */
  group?: string;
}
const {
  num,
  title,
  href,
  description,
  linkLabel = "Read in full",
  group = "objective",
} = Astro.props;

---
<section class="objective">
  {description ? (
    <details class="objective__disclosure" name={group}>
      <summary class="objective__header">
        <span class="objective__num">{num}.</span>
        <span class="objective__title">{title}</span>
      </summary>
      <div class="objective__panel">
        <div class="objective__panel-body">
          <p>{description}</p>
          <ul class="links">
            <li><a href={href}>{`${linkLabel} →`}</a></li>
          </ul>
        </div>
      </div>
    </details>
  ) : (
    <div class="objective__header">
      <a class="objective__link" href={href} aria-label={`Objective ${num}. ${title}`}>
        <span class="objective__num">{num}.</span>
        <span class="objective__title">{title}</span>
      </a>
    </div>
  )}
</section>
