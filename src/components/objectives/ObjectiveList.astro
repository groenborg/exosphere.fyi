---
import { getCollection } from "astro:content";
import { byOrder, isPublished } from "../../lib/content";
import Objective from "./Objective.astro";

/**
 * The whole landing page: a numbered catalogue of the studio's values.
 *
 * Objectives are sourced live from the collection and ordered by their `order`
 * frontmatter — add or reorder an entry and this list renumbers itself. `00` is
 * the standing invitation, everything after it is an essay.
 *
 * Clicking a objective opens it in place: the description unfolds under the
 * title, with an arrow on to the essay itself. Only one stays open at a time.
 */
const entries = await getCollection("objectives", isPublished);
const sorted = entries.sort(byOrder);

const objectives = [
  {
    num: "00",
    title: "Start here",
    href: "/about",
    description: "Who we are, what the studio is for, and how to get hold of us.",
  },
  ...sorted.map((entry, i) => ({
    num: String(i + 1).padStart(2, "0"),
    title: entry.data.title,
    href: `/objectives/${entry.id}`,
    description: entry.data.description,
  })),
];
---
<div class="cluster cluster--index">
  {objectives.map((objective) => <Objective {...objective} />)}
</div>
