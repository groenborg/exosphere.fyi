---
import { navLinks } from "../data/nav-links";

interface Props {
  /**
   * Which top-level page to bracket. Nested routes pass their section, so a
   * broadcast marks `/broadcasts` and an essay marks `/`.
   */
  currentPath: string;
}
const { currentPath } = Astro.props;
---
<header class="nav">
  <a class="nav__brand" href="/">
    <span class="nav__brand-mark" aria-hidden="true"></span>
    <span>Exosphere</span>
  </a>
  <nav class="nav__links">
    {navLinks.map(({ href, label }) => (
      <a href={href} aria-current={href === currentPath ? "page" : undefined}>{label}</a>
    ))}
  </nav>
</header>
