---
import type { CollectionEntry } from "astro:content";
import { longDate } from "../lib/dates";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"broadcasts">;
  /** Computed at build by the remark plugin, so it arrives separately. */
  minutesRead?: string;
}
const { entry, minutesRead } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, draft, heroImage } = entry.data;
---
<BaseLayout title={`${title} — Broadcasts`} description={description} currentPath="/broadcasts">
  <article class="page broadcast">
    {heroImage && (
      <figure class="broadcast__hero">
        <img src={heroImage} alt="" />
      </figure>
    )}

    <div class="page__headline">
      <h1>{title}</h1>
      <p>{description}</p>
      <ul class="meta">
        <li>{author}</li>
        <li><time datetime={pubDate.toISOString()}>{longDate(pubDate)}</time></li>
        {updatedDate && <li>Updated {longDate(updatedDate)}</li>}
        {minutesRead && <li>{minutesRead}</li>}
        {draft && <li>Draft</li>}
        {tags.map((tag) => (
          <li><a href={`/broadcasts/tags/${tag}`}>{tag}</a></li>
        ))}
      </ul>
    </div>

    <div class="page__body">
      <div class="prose">
        <slot />
      </div>

      <nav aria-label="Broadcast navigation">
        <ul class="links">
          <li><a href="/broadcasts">All broadcasts</a></li>
          <li><a href="/rss.xml">Subscribe by RSS</a></li>
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>
