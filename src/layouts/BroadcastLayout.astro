---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  minutesRead?: string;
  draft?: boolean;
  heroImage?: string;
}
const { title, description, pubDate, updatedDate, author, tags, minutesRead, draft, heroImage } =
  Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "2-digit", year: "numeric" });
---
<BaseLayout title={`${title} — Broadcasts`} description={description} currentPath="/broadcasts">
  <article class="page">
    <div class="page__headline">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>

    <div class="page__body">
      {heroImage && (
        <figure class="page__hero">
          <img src={heroImage} alt="" />
        </figure>
      )}

      <ul class="meta">
        <li>{author}</li>
        <li><time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time></li>
        {updatedDate && <li>Updated {fmt(updatedDate)}</li>}
        {minutesRead && <li>{minutesRead}</li>}
        {draft && <li>Draft</li>}
        {tags.map((tag) => (
          <li><a href={`/broadcasts/tags/${tag}`}>{tag}</a></li>
        ))}
      </ul>

      <div class="prose">
        <slot />
      </div>

      <nav aria-label="Broadcast navigation">
        <ul class="links">
          <li><a href="/broadcasts">All broadcasts</a></li>
          <li><a href="/rss.xml">Subscribe by RSS</a></li>
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>
