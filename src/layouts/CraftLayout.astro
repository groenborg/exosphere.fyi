---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  position: number;
  updatedDate?: Date;
  draft?: boolean;
  heroImage?: string;
  prev?: { id: string; title: string; position: number } | null;
  next?: { id: string; title: string; position: number } | null;
}
const { title, description, position, updatedDate, draft, heroImage, prev, next } = Astro.props;

const num = (n: number) => String(n).padStart(2, "0");

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "2-digit", year: "numeric" });
---
<BaseLayout title={`${title} — Signals`} description={description} currentPath="/">
  <article class="page">
    <div class="page__headline">
      <h6>{`Signal ${num(position)}`}</h6>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>

    <div class="page__body">
      {heroImage && (
        <figure class="page__hero">
          <img src={heroImage} alt="" />
        </figure>
      )}

      {(updatedDate || draft) && (
        <ul class="meta">
          {updatedDate && <li>Updated {fmt(updatedDate)}</li>}
          {draft && <li>Draft</li>}
        </ul>
      )}

      <div class="prose">
        <slot />
      </div>

      <nav aria-label="Signal navigation">
        <ul class="links">
          <li><a href="/">All signals</a></li>
          {prev && (
            <li>
              <a href={`/craft/${prev.id}`}>{`← ${num(prev.position)}. ${prev.title}`}</a>
            </li>
          )}
          {next && (
            <li>
              <a href={`/craft/${next.id}`}>{`${num(next.position)}. ${next.title} →`}</a>
            </li>
          )}
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>
