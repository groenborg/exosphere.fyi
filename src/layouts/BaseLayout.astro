---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/mesh.css";
import "../styles/layout.css";
import "../styles/prose.css";
import "../styles/objectives.css";
import "../styles/made.css";
import "../styles/broadcast.css";

import { meshScript } from "../lib/mesh-script";
import { themeScript } from "../lib/theme-script";

interface Props {
  title: string;
  description?: string;
  /** Which nav link to bracket — a section, not necessarily this page's URL. */
  currentPath: string;
}

const {
  title,
  description = "A small studio building joyful, personal software.",
  currentPath,
} = Astro.props;

/* Unfurlers need absolute URLs, so both are resolved against `site` from
   astro.config.mjs rather than emitted as site-root paths. */
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href="/logo-sprite.png" />
    <meta name="theme-color" content="#000000" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Exosphere" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A ringed pixel-art planet above the Exosphere wordmark"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="A ringed pixel-art planet above the Exosphere wordmark"
    />

    <link rel="alternate" type="application/rss+xml" title="Exosphere — Broadcasts" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline set:html={themeScript} />
    <script is:inline set:html={meshScript} />
  </head>
  <body>
    <div class="mesh" aria-hidden="true"></div>
    <Nav currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
    <ThemeToggle />
  </body>
</html>
