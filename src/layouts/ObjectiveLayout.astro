---
import type { CollectionEntry } from "astro:content";
import { longDate } from "../lib/dates";
import BaseLayout from "./BaseLayout.astro";

/** A neighbouring objective, as numbered by the Mission page. */
interface Neighbour {
  id: string;
  title: string;
  position: number;
}

interface Props {
  entry: CollectionEntry<"objectives">;
  /** Its place in the Mission list — derived from `order`, not stored. */
  position: number;
  prev?: Neighbour | null;
  next?: Neighbour | null;
}
const { entry, position, prev, next } = Astro.props;
const { title, description, updatedDate, draft, heroImage } = entry.data;

const num = (n: number) => String(n).padStart(2, "0");
---
<BaseLayout title={`${title} — Objectives`} description={description} currentPath="/">
  <article class="page">
    <div class="page__headline">
      <h6>{`Objective ${num(position)}`}</h6>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>

    <div class="page__body">
      {heroImage && (
        <figure class="page__hero">
          <img src={heroImage} alt="" />
        </figure>
      )}

      {(updatedDate || draft) && (
        <ul class="meta">
          {updatedDate && <li>Updated {longDate(updatedDate)}</li>}
          {draft && <li>Draft</li>}
        </ul>
      )}

      <div class="prose">
        <slot />
      </div>

      <nav aria-label="Objective navigation">
        <ul class="links">
          <li><a href="/">All objectives</a></li>
          {prev && (
            <li>
              <a href={`/objectives/${prev.id}`}>{`← ${num(prev.position)}. ${prev.title}`}</a>
            </li>
          )}
          {next && (
            <li>
              <a href={`/objectives/${next.id}`}>{`${num(next.position)}. ${next.title} →`}</a>
            </li>
          )}
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>
