---
import { getCollection } from "astro:content";
import BroadcastList from "../../components/broadcasts/BroadcastList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byNewest, isPublished, toBroadcastItems } from "../../lib/content";

const all = await getCollection("broadcasts", isPublished);
const items = await toBroadcastItems(all.sort(byNewest));
---
<BaseLayout
  title="Exosphere — Broadcasts"
  description="Postcards, notes, and field reports from a small studio building joyful software."
  currentPath="/broadcasts"
>
  <section class="page">
    <div class="page__headline">
      <h6>{`Broadcasts · ${items.length} ${items.length === 1 ? "post" : "posts"}`}</h6>
      <h1>Dispatches from the studio.</h1>
      <p>
        Long-form notes, half-formed ideas, and the occasional weekend
        experiment. We post when we have something worth saying.
      </p>
      <ul class="links">
        <li><a href="/broadcasts/tags">Browse by topic</a></li>
        <li><a href="/rss.xml">Subscribe by RSS</a></li>
      </ul>
    </div>

    <BroadcastList items={items} />
  </section>
</BaseLayout>
