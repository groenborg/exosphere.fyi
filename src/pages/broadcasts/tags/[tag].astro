---
import { getCollection } from "astro:content";
import BroadcastList from "../../../components/broadcasts/BroadcastList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { byNewest, isPublished, toBroadcastItems } from "../../../lib/content";

export async function getStaticPaths() {
  const all = await getCollection("broadcasts", isPublished);

  const tags = new Set<string>();
  for (const entry of all) {
    for (const tag of entry.data.tags) tags.add(tag);
  }

  return Array.from(tags).map((tag) => {
    const posts = all.filter((e) => e.data.tags.includes(tag)).sort(byNewest);
    return { params: { tag }, props: { tag, posts } };
  });
}

const { tag, posts } = Astro.props;

const items = await toBroadcastItems(posts);
---
<BaseLayout
  title={`Exosphere — Broadcasts tagged "${tag}"`}
  description={`Broadcasts on the topic of ${tag}.`}
  currentPath="/broadcasts"
>
  <section class="page">
    <div class="page__headline">
      <h6>{`Tag · ${items.length} ${items.length === 1 ? "post" : "posts"}`}</h6>
      <h1>On {tag}.</h1>
      <ul class="links">
        <li><a href="/broadcasts/tags">All tags</a></li>
        <li><a href="/broadcasts">All broadcasts</a></li>
      </ul>
    </div>

    <BroadcastList items={items} empty={`Nothing tagged ${tag} yet.`} />
  </section>
</BaseLayout>
