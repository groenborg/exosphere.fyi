---
import { getCollection, render } from "astro:content";
import BroadcastLayout from "../../layouts/BroadcastLayout.astro";
import { isPublished } from "../../lib/content";

export async function getStaticPaths() {
  const all = await getCollection("broadcasts", isPublished);
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const minutesRead = remarkPluginFrontmatter?.minutesRead as string | undefined;
---
<BroadcastLayout entry={entry} minutesRead={minutesRead}>
  <Content />
</BroadcastLayout>
