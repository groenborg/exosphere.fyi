---
import { getCollection, render } from "astro:content";
import CraftLayout from "../../layouts/CraftLayout.astro";
import { byOrder, isPublished } from "../../lib/content";

export async function getStaticPaths() {
  const all = await getCollection("craft", isPublished);
  const sorted = all.sort(byOrder);

  return sorted.map((entry, i) => {
    const prevEntry = sorted[i - 1];
    const nextEntry = sorted[i + 1];
    return {
      params: { slug: entry.id },
      props: {
        entry,
        position: i + 1,
        prev: prevEntry ? { id: prevEntry.id, title: prevEntry.data.title, position: i } : null,
        next: nextEntry ? { id: nextEntry.id, title: nextEntry.data.title, position: i + 2 } : null,
      },
    };
  });
}

const { entry, position, prev, next } = Astro.props;
const { Content } = await render(entry);
---
<CraftLayout entry={entry} position={position} prev={prev} next={next}>
  <Content />
</CraftLayout>
