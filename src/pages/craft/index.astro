---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const all = await getCollection("craft", ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true
);

const sorted = all.sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Exosphere — Craft"
  description="How we build, what we believe, and why. A small set of essays on the craft of a joyful software studio."
  currentPath="/craft"
>
  <section class="page">
    <div class="page__headline">
      <h6>{`Craft · ${sorted.length} ${sorted.length === 1 ? "entry" : "entries"}`}</h6>
      <h1>How we build, and why.</h1>
      <p>
        The signals in full — values, working habits, and opinions strong
        enough to act on. Best read in order, but each one stands alone.
      </p>
    </div>

    <div class="list">
      <ol class="list__container">
        {sorted.length === 0 && (
          <li class="list__empty">No entries yet — check back soon.</li>
        )}
        {sorted.map((entry, i) => (
          <li class="list__item">
            <ul class="meta">
              <li>{`Signal ${String(i + 1).padStart(2, "0")}`}</li>
              {entry.data.draft && <li>Draft</li>}
            </ul>
            <h2 class="list__title">
              <a href={`/craft/${entry.id}`}>{entry.data.title}</a>
            </h2>
            <p>{entry.data.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
