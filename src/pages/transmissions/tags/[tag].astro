---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TransmissionList from "../../../components/transmissions/TransmissionList.astro";

export async function getStaticPaths() {
  const all = await getCollection("transmissions", ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );

  const tags = new Set<string>();
  for (const entry of all) {
    for (const tag of entry.data.tags) tags.add(tag);
  }

  return Array.from(tags).map((tag) => {
    const posts = all
      .filter((e) => e.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
    return { params: { tag }, props: { tag, posts } };
  });
}

const { tag, posts } = Astro.props;

const items = await Promise.all(
  posts.map(async (entry) => {
    const { remarkPluginFrontmatter } = await render(entry);
    return {
      id: entry.id,
      ...entry.data,
      minutesRead: remarkPluginFrontmatter?.minutesRead as string | undefined,
    };
  })
);
---
<BaseLayout
  title={`Exosphere — Transmissions tagged "${tag}"`}
  description={`Transmissions on the topic of ${tag}.`}
  currentPath="/transmissions"
>
  <section class="page">
    <div class="page__headline">
      <h6>{`Tag · ${items.length} ${items.length === 1 ? "post" : "posts"}`}</h6>
      <h1>On {tag}.</h1>
      <ul class="links">
        <li><a href="/transmissions/tags">All tags</a></li>
        <li><a href="/transmissions">All transmissions</a></li>
      </ul>
    </div>

    <TransmissionList items={items} empty={`Nothing tagged ${tag} yet.`} />
  </section>
</BaseLayout>
