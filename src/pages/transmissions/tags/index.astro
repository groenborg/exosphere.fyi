---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const all = await getCollection("transmissions", ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true
);

const counts = new Map<string, number>();
for (const entry of all) {
  for (const tag of entry.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = Array.from(counts.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
---
<BaseLayout
  title="Exosphere — Transmission tags"
  description="Browse Transmissions by topic."
  currentPath="/transmissions"
>
  <section class="page">
    <div class="page__headline">
      <h6>Transmissions · Tags</h6>
      <h1>Browse by topic.</h1>
      <p>Every topic in the archive, most written about first.</p>
    </div>

    <div class="page__body">
      {tags.length === 0 ? (
        <p class="list__empty">No tags yet.</p>
      ) : (
        <ul class="links">
          {tags.map(({ tag, count }) => (
            <li>
              <a href={`/transmissions/tags/${tag}`}>{tag}</a> <small>{count}</small>
            </li>
          ))}
        </ul>
      )}

      <ul class="links">
        <li><a href="/transmissions">All transmissions</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
