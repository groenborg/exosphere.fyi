---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const all = await getCollection("made", ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true
);

const sorted = all.sort((a, b) => {
  const ao = a.data.order ?? Number.POSITIVE_INFINITY;
  const bo = b.data.order ?? Number.POSITIVE_INFINITY;
  if (ao !== bo) return ao - bo;
  return a.data.name.localeCompare(b.data.name);
});

const typeLabel = (t: string) => {
  switch (t) {
    case "oss":
      return "Open source";
    case "tool":
      return "Tool";
    case "experiment":
      return "Experiment";
    default:
      return "Product";
  }
};

const isExternal = (u: string) => /^https?:\/\//i.test(u);

/** Everything the cards used to carry in chips and badges, on one line. */
const metaFor = (data: (typeof sorted)[number]["data"]) => [
  typeLabel(data.type),
  ...(data.year ? [String(data.year)] : []),
  ...data.tags,
];
---
<BaseLayout
  title="Exosphere — Made"
  description="Things we've shipped, open-sourced, or quietly maintained — products, tools, and small experiments."
  currentPath="/made"
>
  <section class="page">
    <div class="page__headline">
      <h1>Things we've made</h1>
      <p>
        Products out in the world, open-source tools, and the occasional
        weekend experiment. Every link goes straight to the thing itself —
        no case studies, no gated decks.
      </p>
    </div>

    <div class="list list--wide">
      <div class="list__container">
        {sorted.length === 0 && (
          <p class="list__empty">Nothing here yet — check back soon.</p>
        )}
        {sorted.map((entry) => {
          const { name, description, url, repo, image } = entry.data;
          const external = isExternal(url);
          const out = external
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {};
          return (
            <article class="list__item">
              <div class="made__wrap">
                {image && (
                  <figure>
                    <a href={url} {...out}>
                      <img src={image} alt={name} />
                    </a>
                  </figure>
                )}
                <div class="made__content">
                  <ul class="meta">
                    {metaFor(entry.data).map((bit) => <li>{bit}</li>)}
                  </ul>
                  <h2 class="list__title">
                    <a href={url} {...out}>{name}</a>
                  </h2>
                  <p>{description}</p>
                  <ul class="links">
                    <li>
                      <a href={url} {...out}>Visit {name}</a>
                    </li>
                    {repo && repo !== url && (
                      <li>
                        <a href={repo} target="_blank" rel="noopener noreferrer">
                          Read the source
                        </a>
                      </li>
                    )}
                  </ul>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
